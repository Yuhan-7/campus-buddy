# Copy to .env and replace both passwords before starting.
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password
WEB_PORT=8088
ADMIN_EMAIL=admin@campus-buddy.local
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# ---------- 演示账号速查（DEMO_DATA=true 时自动生成） ----------
# 测试账号：test@buddy.demo / test12345（密保答案：杭州 / 小橘 / 羽毛球）
# 演示用户：demo01@buddy.demo ~ demo29@buddy.demo / demo12345
# 已停用账号：demo30@buddy.demo / demo12345（用于演示管理端“恢复账号”）
# 管理员：上面的 ADMIN_EMAIL / ADMIN_PASSWORD
# 演示数据开关：true 时首次启动写入测试账号 test@buddy.demo 和 30 个演示用户（只写一次）；正式使用请改为 false
DEMO_DATA=true
# 大模型接口（选填，OpenAI 兼容格式）。三项都填写才启用；不填时“智能填写”和“违规初筛”使用本地规则
# 例（DeepSeek）：AI_API_URL=https://api.deepseek.com  AI_MODEL=deepseek-flash
# 例（阿里云百炼）：AI_API_URL=控制台给出的 compatible-mode/v1 地址  AI_MODEL=qwen-plus
# AI_API_KEY 是你的私人密钥，不要提交到 git、不要发给别人
AI_API_URL=
AI_API_KEY=
AI_MODEL=
