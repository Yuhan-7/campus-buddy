# Copy to .env and replace both passwords before starting.
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password
WEB_PORT=8088
ADMIN_EMAIL=admin@campus-buddy.local
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# 演示数据开关：true 时首次启动写入测试账号 test@buddy.demo 和 30 个演示用户（只写一次）；正式使用请改为 false
DEMO_DATA=true
# 大模型接口（选填，OpenAI 兼容格式）。三项都填写才启用；不填时“智能填写”和“违规初筛”使用本地规则
# 例：AI_API_URL=https://你的平台地址/v1  AI_MODEL=模型名称
AI_API_URL=
AI_API_KEY=
AI_MODEL=
